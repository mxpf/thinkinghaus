3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"thinking.haus - Caught in a web"}],["$","meta","1",{"name":"description","content":"I’ve been returning to Andrew Plotkin’s website for about twenty years. Back then, I was obsessed with interactive fiction, and I had never seen anything like the way Spider and Web played with deception, memory, and the role of the player. I was so struck by its craft that I went looking for the person who had made it."}],["$","meta","2",{"name":"application-name","content":"thinking.haus"}],["$","meta","3",{"name":"author","content":"Max Pfennighaus"}],["$","link","4",{"rel":"author","href":"https://maxpfennig.haus/"}],["$","meta","5",{"name":"creator","content":"Max Pfennighaus"}],["$","meta","6",{"name":"publisher","content":"Max Pfennighaus"}],["$","meta","7",{"property":"og:title","content":"thinking.haus"}],["$","meta","8",{"property":"og:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","9",{"property":"og:site_name","content":"thinking.haus"}],["$","meta","10",{"property":"og:image","content":"https://thinking.haus/og.png"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"thinking.haus"}],["$","meta","13",{"name":"twitter:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","14",{"name":"twitter:image","content":"https://thinking.haus/og.png"}],["$","link","15",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"image/svg+xml","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","17",{"rel":"canonical","href":"https://thinking.haus/caug