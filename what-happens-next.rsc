3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"thinking.haus - What happens next?"}],["$","meta","1",{"name":"description","content":"Jasper Morrison’s Utilism vs. Uselessnism describes what he calls Utilism’s greatest urban triumph: a bus station at Fisch Platz in Graz. He and his collaborators removed travel company stickers from the café windows so passengers could see whether their buses had arrived, then added a couple of speed bumps so they could cross the road safely. That was more or less the project."}],["$","meta","2",{"name":"application-name","content":"thinking.haus"}],["$","meta","3",{"name":"author","content":"Max Pfennighaus"}],["$","link","4",{"rel":"author","href":"https://maxpfennig.haus/"}],["$","meta","5",{"name":"creator","content":"Max Pfennighaus"}],["$","meta","6",{"name":"publisher","content":"Max Pfennighaus"}],["$","meta","7",{"property":"og:title","content":"thinking.haus"}],["$","meta","8",{"property":"og:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","9",{"property":"og:site_name","content":"thinking.haus"}],["$","meta","10",{"property":"og:image","content":"https://thinking.haus/og.png"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"thinking.haus"}],["$","meta","13",{"name":"twitter:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","14",{"name":"twitter:image","content":"https://thinking.haus/og.png"}],["$","link","15",{"data-vinext-streamed-icon":"$undefined","rel":"shortcut icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"image/svg+xml","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","17",{"rel":"canonical","href":"https://thinking.haus/what-happens-next"}],["$","link","18",{"rel":"alternate","type":"application/rss+xml","href":"https://thinking.haus/rss.xml"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["what-happens-next"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"slug|what-happens-next|d","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/what-happens-next","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/what-happens-next"}]}],null]}]}]}]}]}]}]}],null,null]
