0:{"__route":"route:/where-the-work-is","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","__sourcePage":"/[slug]/page","__staticSiblings":["now"],"page:/where-the-work-is":"$L1","layout:/":[[[["$","link","css:/_next/static/css/index.BFRmtUwO.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.BFRmtUwO.css","data-rsc-css-href":"/_next/static/css/index.BFRmtUwO.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":[["$","$L2",null,{}],["$","script",null,{"defer":true,"src":"/author-mode.js"}],["$","script",null,{"defer":true,"src":"https://trackinghaus-alpha.vercel.app/tracker.js","data-site":"thinkinghaus","data-endpoint":"https://trackinghaus-alpha.vercel.app/api/collect"}]]}]}]],null],"route:/where-the-work-is":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Thinkinghaus - Where the work is"}],["$","meta","1",{"name":"description","content":"I was reading Dave Snider’s description of how he uses AI when I hit a distinction that seemed completely reasonable and, at the same time, almost exactly opposite to my own experience."}],["$","meta","2",{"property":"og:title","content":"Thinkinghaus"}],["$","meta","3",{"property":"og:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","4",{"property":"og:image","content":"https://thinking.haus/og.png"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Thinkinghaus"}],["$","meta","7",{"name":"twitter:description","content":"Notes on attention, work, and the occasional strange thing."}],["$","meta","8",{"name":"twitter:image","content":"https://thinking.haus/og.png"}],["$","link","9",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","10",{"rel":"icon","href":"/favicon.svg","type":"image/svg+xml"}],["$","link","11",{"rel":"canonical","href":"https://thinking.haus/where-the-work-is"}],["$","link","12",{"rel":"alternate","type":"application/rss+xml","href":"https://thinking.haus/rss.xml"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"fallback":"$4","children":["$","$L5",null,{"fallback":"$4","children":["$","$L6",null,{"providerId":"layout:/","segmentMap":{"children":["where-the-work-is"]},"children":["$","$L7",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L8",null,{"children":["$","$L9",null,{"children":[["$","$L6",null,{"providerId":"page:/where-the-work-is","segmentMap":{"children":["__PAGE__"]},"children":["$","$L7",null,{"id":"page:/where-the-work-is"}]}],null]}]}]}]}]}]}],null,null],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:c75e66a7605490d9","deploymentVersion":"58b00bb3-0917-45bb-a0eb-351e35f604bd","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null},"__renderObservation":{"schemaVersion":1,"output":{"kind":"app-rsc","mountedSlotsFingerprint":null,"renderEpoch":null,"rootBoundaryId":"/","routeId":"route:/where-the-work-is"},"completeness":"partial","boundaryOutcome":{"kind":"unknown"},"requestApis":[{"kind":"connection","status":"unknown"},{"kind":"cookies","status":"unknown"},{"kind":"draftMode","status":"unknown"},{"kind":"headers","status":"unknown"},{"kind":"params","status":"observed"},{"kind":"searchParams","status":"unknown"}],"dynamicFetches":[],"cacheTags":["/where-the-work-is","_N_T_/[slug]/layout","_N_T_/[slug]/page","_N_T_/layout","_N_T_/where-the-work-is"],"pathTags":["/where-the-work-is"],"cacheability":"unknown","downgrade":{"target":"freshRender","reasons":[{"code":"CP_DOWNGRADE_CACHEABILITY_UNKNOWN","target":"freshRender"},{"code":"CP_DOWNGRADE_INCOMPLETE_OBSERVATION","completeness":"partial","target":"freshRender"},{"code":"CP_DOWNGRADE_UNKNOWN_REQUEST_API","requestApi":"connection","target":"freshRender"},{"code":"CP_DOWNGRADE_UNKNOWN_REQUEST_API","requestApi":"cookies","target":"freshRender"},{"code":"CP_DOWNGRADE_UNKNOWN_REQUEST_API","requestApi":"draftMode","target":"freshRender"},{"code":"CP_DOWNGRADE_UNKNOWN_REQUEST_API","requestApi":"headers","target":"freshRender"},{"code":"CP_DOWNGRADE_PUBLIC_REQUEST_API","requestApi":"params","target":"publicVariant"},{"code":"CP_DOWNGRADE_UNKNOWN_REQUEST_API","requestApi":"searchParams","target":"freshRender"}],"fallback":{"kind":"breakerFallback","code":"CP_PRIVATE_DYNAMIC_DOWNGRADE","mode":"renderFresh","scope":"affectedOutput","fields":{"reasonCodes":["CP_DOWNGRADE_CACHEABILITY_UNKNOWN","CP_DOWNGRADE_INCOMPLETE_OBSERVATION","CP_DOWNGRADE_UNKNOWN_REQUEST_API","CP_DOWNGRADE_UNKNOWN_REQUEST_API","CP_DOWNGRADE_UNKNOWN_REQUEST_API","CP_DOWNGRADE_UNKNOWN_REQUEST_API","CP_DOWNGRADE_PUBLIC_REQUEST_API","CP_DOWNGRADE_UNKNOWN_REQUEST_API"],"target":"freshRender"}},"isPublicCacheCandidate":false}}}
1:["$","main",null,{"className":"site article-page","children":["$","div",null,{"className":"article-frame","children":[["$","a",null,{"className":"desktop-brand","href":"/","children":["$","span",null,{"className":"letter-cascade is-in","aria-label":"Thinkinghaus","children":[["$","b","T-0",{"aria-hidden":"true","style":{"--letter-cascade-index":0},"children":"T"}],["$","b","h-1",{"aria-hidden":"true","style":{"--letter-cascade-index":1},"children":"h"}],["$","b","i-2",{"aria-hidden":"true","style":{"--letter-cascade-index":2},"children":"i"}],["$","b","n-3",{"aria-hidden":"true","style":{"--letter-cascade-index":3},"children":"n"}],["$","b","k-4",{"aria-hidden":"true","style":{"--letter-cascade-index":4},"children":"k"}],["$","b","i-5",{"aria-hidden":"true","style":{"--letter-cascade-index":5},"children":"i"}],["$","b","n-6",{"aria-hidden":"true","style":{"--letter-cascade-index":6},"children":"n"}],["$","b","g-7",{"aria-hidden":"true","style":{"--letter-cascade-index":7},"children":"g"}],["$","b","h-8",{"aria-hidden":"true","style":{"--letter-cascade-index":8},"children":"h"}],["$","b","a-9",{"aria-hidden":"true","style":{"--letter-cascade-index":9},"children":"a"}],["$","b","u-10",{"aria-hidden":"true","style":{"--letter-cascade-index":10},"children":"u"}],["$","b","s-11",{"aria-hidden":"true","style":{"--letter-cascade-index":11},"children":"s"}]]}]}],["$","article",null,{"className":"article-column","data-content-slug":"where-the-work-is","data-content-title":"Where the work is","children":[["$","header",null,{"className":"article-header","children":[["$","h1",null,{"children":"Where the work is"}],["$","p",null,{"children":"August 13, 2026"}],["$","p",null,{"children":"7 minutes"}],["$","p",null,{"className":"author-edit-action","hidden":true,"children":["$","a",null,{"href":"https://thinkinghaus-studio.maxpfennighaus.workers.dev/","children":"Edit"}]}]]}],["$","div",null,{"className":"article-body","children":[[["$","p","0-I was reading [Dave Snider’s description of how he uses AI](https://davesnider.com/how-i-use-ai) when I hit a distinction that seemed completely reasonable and, at the same time, almost exactly opposite to my own experience.",{"className":"$undefined","children":["I was reading ",["$","a","1",{"href":"https://davesnider.com/how-i-use-ai","rel":"noreferrer","children":["Dave Snider’s description of how he uses AI"]}]," when I hit a distinction that seemed completely reasonable and, at the same time, almost exactly opposite to my own experience."]}],["$","p","1-Snider is a software developer. He uses AI heavily for programming, including on projects where the models are doing a pretty heroic amount of the coding. He’s comfortable with this because the code isn’t really the thing he’s trying to make. The software is. If AI helps him build something he otherwise couldn’t build, great.",{"className":"$undefined","children":["Snider is a software developer. He uses AI heavily for programming, including on projects where the models are doing a pretty heroic amount of the coding. He’s comfortable with this because the code isn’t really the thing he’s trying to make. The software is. If AI helps him build something he otherwise couldn’t build, great."]}],["$","p","2-Writing is different: “with writing, the output is the writing,” he says. So he keeps AI mostly away from it. He spent years developing that skill and doesn’t want a machine augmenting his voice. He feels similarly about illustration. Getting the image isn’t the whole point. Collaborating with an illustrator is part of the thing he values.",{"className":"$undefined","children":["Writing is different: “with writing, the output is the writing,” he says. So he keeps AI mostly away from it. He spent years developing that skill and doesn’t want a machine augmenting his voice. He feels similarly about illustration. Getting the image isn’t the whole point. Collaborating with an illustrator is part of the thing he values."]}],"$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"],null]}],"$L23"]}]]}]}]
a:["$","p","3-I read this and thought: yes. Then I thought: wait, no.",{"className":"$undefined","children":["I read this and thought: yes. Then I thought: wait, no."]}]
b:["$","p","4-[Thinkinghaus](https://thinking.haus/about) exists largely because [AI got involved in my writing](https://thinking.haus/ai). Not just proofreading or fixing commas or suggesting that I replace “very good” with “excellent,” which is the sort of AI help that makes me want to throw my laptop into a pond. I mean involved: asking questions, challenging an idea, noticing contradictions, helping research some peculiar rabbit hole, drafting, getting it wrong, drafting again. Occasionally it produces a sentence I love. More often it produces one that sounds like it has recently completed an executive leadership seminar, with far too many em dashes.",{"className":"$undefined","children":[["$","a","0",{"href":"https://thinking.haus/about","rel":"noreferrer","children":["Thinkinghaus"]}]," exists largely because ",["$","a","2",{"href":"https://thinking.haus/ai","rel":"noreferrer","children":["AI got involved in my writing"]}],". Not just proofreading or fixing commas or suggesting that I replace “very good” with “excellent,” which is the sort of AI help that makes me want to throw my laptop into a pond. I mean involved: asking questions, challenging an idea, noticing contradictions, helping research some peculiar rabbit hole, drafting, getting it wrong, drafting again. Occasionally it produces a sentence I love. More often it produces one that sounds like it has recently completed an executive leadership seminar, with far too many em dashes."]}]
c:["$","p","5-The strange thing is that I don’t feel less involved because of this. I feel more involved. Before Thinkinghaus, plenty of thoughts rattled around in my head without ever being required to stand up straight and identify themselves. I’d have an intuition about something, feel vaguely satisfied that I understood it, and move on.",{"className":"$undefined","children":["The strange thing is that I don’t feel less involved because of this. I feel more involved. Before Thinkinghaus, plenty of thoughts rattled around in my head without ever being required to stand up straight and identify themselves. I’d have an intuition about something, feel vaguely satisfied that I understood it, and move on."]}]
d:["$","p","6-For me, writing makes that way harder. Conversation makes it harder still. I say what I think. Somebody asks what I mean. I explain. They notice a contradiction. I get annoyed. Unfortunately, they have a point, and the thought changes.",{"className":"$undefined","children":["For me, writing makes that way harder. Conversation makes it harder still. I say what I think. Somebody asks what I mean. I explain. They notice a contradiction. I get annoyed. Unfortunately, they have a point, and the thought changes."]}]
e:["$","p","7-That process has become more important to me than the physical production of sentences.",{"className":"$undefined","children":["That process has become more important to me than the physical production of sentences."]}]
f:["$","p","8-This is where Snider’s piece gets particularly interesting to me, because elsewhere he describes AI in almost exactly these terms. He talks about using it as a “work partner who can teach me as I go.” In one example, he has Claude help him understand run-length encoding while building something he probably wouldn’t have attempted otherwise. The interesting result isn’t merely that some code appeared. He knows something afterward that he didn’t know before.",{"className":"$undefined","children":["This is where Snider’s piece gets particularly interesting to me, because elsewhere he describes AI in almost exactly these terms. He talks about using it as a “work partner who can teach me as I go.” In one example, he has Claude help him understand run-length encoding while building something he probably wouldn’t have attempted otherwise. The interesting result isn’t merely that some code appeared. He knows something afterward that he didn’t know before."]}]
10:["$","p","9-The artifact is a trace of something that happened to the person making it.",{"className":"$undefined","children":["The artifact is a trace of something that happened to the person making it."]}]
11:["$","p","10-To me, that feels like a useful test. It also makes the usual argument about AI and authorship feel incomplete. We spend a lot of time asking who made the sentence, the image, the code, the song. Fair enough. But that question assumes the finished object is where authorship primarily lives, and I’m less sure about that these days.",{"className":"$undefined","children":["To me, that feels like a useful test. It also makes the usual argument about AI and authorship feel incomplete. We spend a lot of time asking who made the sentence, the image, the code, the song. Fair enough. But that question assumes the finished object is where authorship primarily lives, and I’m less sure about that these days."]}]
12:["$","p","11-Imagine a person who writes 1,500 words entirely by hand. The essay is good. It’s thoughtful, specific, and well made. It contains ideas he’s been carrying around for years, and the act of writing gives them a shape they didn’t have before.",{"className":"$undefined","children":["Imagine a person who writes 1,500 words entirely by hand. The essay is good. It’s thoughtful, specific, and well made. It contains ideas he’s been carrying around for years, and the act of writing gives them a shape they didn’t have before."]}]
13:["$","p","12-Now imagine another person who spends three hours talking with an AI. He rejects most of what it suggests. He remembers something that happened when he was seventeen. He follows a reference into a subject he barely understands. He changes his mind twice. At one point the machine writes something polished and convincing that he realizes he doesn’t believe at all. Eventually six paragraphs survive, some of whose sentences were generated by the model.",{"className":"$undefined","children":["Now imagine another person who spends three hours talking with an AI. He rejects most of what it suggests. He remembers something that happened when he was seventeen. He follows a reference into a subject he barely understands. He changes his mind twice. At one point the machine writes something polished and convincing that he realizes he doesn’t believe at all. Eventually six paragraphs survive, some of whose sentences were generated by the model."]}]
14:["$","p","13-Which one contains more authorship?",{"className":"$undefined","children":["Which one contains more authorship?"]}]
15:["$","p","14-I don’t know. That’s what interests me.",{"className":"$undefined","children":["I don’t know. That’s what interests me."]}]
16:["$","p","15-“Who typed the words?” doesn’t get us very far. There’s something else in there: attention, judgment, selection, curiosity, responsibility, and the peculiar route through the material that one person took and another person wouldn’t have. Whose encounter with the world is this?",{"className":"optical-margin-fallback","children":["“Who typed the words?” doesn’t get us very far. There’s something else in there: attention, judgment, selection, curiosity, responsibility, and the peculiar route through the material that one person took and another person wouldn’t have. Whose encounter with the world is this?"]}]
17:["$","p","16-That question has become more useful to me than asking whether something was “AI-generated,” a phrase currently being asked to carry roughly the semantic workload of the word “food.” Microwave lasagna and an eight-course dinner both involved heat.",{"className":"$undefined","children":["That question has become more useful to me than asking whether something was “AI-generated,” a phrase currently being asked to carry roughly the semantic workload of the word “food.” Microwave lasagna and an eight-course dinner both involved heat."]}]
18:["$","p","17-Of course this can become a wonderfully convenient excuse. I can prompt a model with “write something profound about mortality in my voice,” slap the result onto Thinkinghaus and announce that my curatorial judgment constitutes authorship. That would indeed be bullshit. The machinery doesn’t become personal because I stood nearby while it ran.",{"className":"$undefined","children":["Of course this can become a wonderfully convenient excuse. I can prompt a model with “write something profound about mortality in my voice,” slap the result onto Thinkinghaus and announce that my curatorial judgment constitutes authorship. That would indeed be bullshit. The machinery doesn’t become personal because I stood nearby while it ran."]}]
19:["$","p","18-My own boundary seems to be whether I’m still home.",{"className":"$undefined","children":["My own boundary seems to be whether I’m still home."]}]
1a:["$","p","19-If an idea feels foreign, I don’t want it. If the route to the idea doesn’t resemble the way I actually think, I don’t want that either. Sometimes AI produces something much smarter than what I was trying to say, and that’s exactly the problem. I can admire it without pretending it belongs to me. Other times it asks the annoying question that makes me realize I’ve been protecting a weak idea for half an hour. That belongs.",{"className":"$undefined","children":["If an idea feels foreign, I don’t want it. If the route to the idea doesn’t resemble the way I actually think, I don’t want that either. Sometimes AI produces something much smarter than what I was trying to say, and that’s exactly the problem. I can admire it without pretending it belongs to me. Other times it asks the annoying question that makes me realize I’ve been protecting a weak idea for half an hour. That belongs."]}]
1b:["$","p","20-This is also why I keep getting pulled toward [people whose work leaves a strong trace of how they think](https://thinking.haus/caught-in-a-web). Andrew Plotkin is a good example. His games are remarkable, but so is the larger accumulation around them: notes, lists, archives, technical experiments, opinions, systems, and years of sustained attention. The attraction isn’t simply polish. It’s recognition. You can feel somebody in there.",{"className":"$undefined","children":["This is also why I keep getting pulled toward ",["$","a","1",{"href":"https://thinking.haus/caught-in-a-web","rel":"noreferrer","children":["people whose work leaves a strong trace of how they think"]}],". Andrew Plotkin is a good example. His games are remarkable, but so is the larger accumulation around them: notes, lists, archives, technical experiments, opinions, systems, and years of sustained attention. The attraction isn’t simply polish. It’s recognition. You can feel somebody in there."]}]
1c:["$","p","21-What I like about Snider’s approach is that he isn’t trying to solve this for everybody. His boundaries are personal. AI can write code. It can help him learn. It doesn’t write his essays. It doesn’t make his illustrations. He has worked out where he wants the machine in the house and where he doesn’t.",{"className":"$undefined","children":["What I like about Snider’s approach is that he isn’t trying to solve this for everybody. His boundaries are personal. AI can write code. It can help him learn. It doesn’t write his essays. It doesn’t make his illustrations. He has worked out where he wants the machine in the house and where he doesn’t."]}]
1d:["$","p","22-I suspect most of us are doing some version of this now. We’re developing tiny customs around our tools. Claude refactors this function. ChatGPT argues with me about an essay. Neither gets my database password.",{"className":"$undefined","children":["I suspect most of us are doing some version of this now. We’re developing tiny customs around our tools. Claude refactors this function. ChatGPT argues with me about an essay. Neither gets my database password."]}]
1e:["$","p","23-The interesting part for me isn’t that Snider and I draw the line in different places. It’s why. For him, allowing AI deeply into writing threatens a practice he wants to preserve. For me, allowing AI deeply into writing created a practice I hadn’t really had before. I write more because of it. I interrogate my own thinking more. I’m less able to get away with the cozy little feeling that I understand something merely because I have an opinion about it.",{"className":"$undefined","children":["The interesting part for me isn’t that Snider and I draw the line in different places. It’s why. For him, allowing AI deeply into writing threatens a practice he wants to preserve. For me, allowing AI deeply into writing created a practice I hadn’t really had before. I write more because of it. I interrogate my own thinking more. I’m less able to get away with the cozy little feeling that I understand something merely because I have an opinion about it."]}]
1f:["$","p","24-Neither experience cancels the other. They point me toward a better question: when a machine can produce the artifact cheaply, where does the work move?",{"className":"$undefined","children":["Neither experience cancels the other. They point me toward a better question: when a machine can produce the artifact cheaply, where does the work move?"]}]
20:["$","p","25-For me, a lot of it moves into attention, judgment, curiosity, and the ability to recognize when something is technically amazing but somehow not mine. It moves into knowing myself well enough to notice when I’ve left the house.",{"className":"$undefined","children":["For me, a lot of it moves into attention, judgment, curiosity, and the ability to recognize when something is technically amazing but somehow not mine. It moves into knowing myself well enough to notice when I’ve left the house."]}]
21:["$","p","26-Snider uses AI to write code and protects his writing from it. I use AI to help write Thinkinghaus partly because writing, for me, turns out not to be where the work ends.",{"className":"$undefined","children":["Snider uses AI to write code and protects his writing from it. I use AI to help write Thinkinghaus partly because writing, for me, turns out not to be where the work ends."]}]
22:["$","p","27-It’s where I’ve finally started doing it.",{"className":"$undefined","children":["It’s where I’ve finally started doing it."]}]
23:["$","footer",null,{"className":"footer","children":[["$","a",null,{"className":"footer-brand","href":"/","children":"Thinkinghaus"}],["$","nav",null,{"className":"footer-links","aria-label":"Site","children":[["$","a",null,{"href":"/about","children":"About"}],["$","a",null,{"href":"/links","children":"Links"}],["$","a",null,{"href":"/now","children":"Now"}],["$","a",null,{"href":"https://trackinghaus-alpha.vercel.app","children":"Stats"}],["$","a",null,{"href":"/rss.xml","type":"application/rss+xml","children":"RSS"}]]}]]}]
